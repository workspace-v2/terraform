global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    project: ${name_prefix}

rule_files:
  - /etc/prometheus/alert-rules.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
        labels: { env: shared, role: monitoring, instance: monitoring-prometheus }

  # ---- EC2 host metrics (CPU, memory, disk, network, systemd units) ----
  - job_name: node
    static_configs:
%{ for e in environments ~}
      - targets: ["${e.database_ip}:9100"]
        labels: { env: ${e.name}, role: database, instance: ${e.name}-database }
      - targets: ["${e.redis_ip}:9100"]
        labels: { env: ${e.name}, role: redis, instance: ${e.name}-redis }
      - targets: ["${e.legacy_backend_ip}:9100"]
        labels: { env: ${e.legacy_name}, role: backend, platform: ec2, instance: ${e.legacy_name}-backend }
%{ endfor ~}
      - targets: ["${monitoring_ip}:9100"]
        labels: { env: shared, role: monitoring, instance: monitoring }
%{ if load_generator_ip != "" ~}
      - targets: ["${load_generator_ip}:9100"]
        labels: { env: shared, role: load-generator, instance: load-generator }
%{ endif ~}

  # ---- Spring Boot actuator / Micrometer (HTTP, JVM, HikariCP, Tomcat, logback) ----
  # ECS 태스크 IP는 동적이라 Cloud Map A 레코드로 모든 태스크를 찾는다.
  # instance 라벨: <env>-backend-<task ip>  (태스크별로 지표가 나뉜다)
%{ for e in environments ~}
  - job_name: spring-actuator-${e.name}
    metrics_path: /actuator/prometheus
    dns_sd_configs:
      - names: ["${e.backend_dns}"]
        type: A
        port: 8081
        refresh_interval: 15s
    relabel_configs:
      - target_label: job
        replacement: spring-actuator
      - target_label: env
        replacement: ${e.name}
      - target_label: role
        replacement: backend
      - target_label: platform
        replacement: ecs
      - source_labels: [__address__]
        regex: "(.+):\\d+"
        target_label: instance
        replacement: "${e.name}-backend-$1"
%{ endfor ~}

  # 기존 EC2 단일 서버 백엔드 (env=one-<env>). 평소엔 중지 상태라 TargetDown 알림에서 제외한다.
  - job_name: spring-actuator-legacy
    metrics_path: /actuator/prometheus
    static_configs:
%{ for e in environments ~}
      - targets: ["${e.legacy_backend_ip}:8081"]
        labels: { env: ${e.legacy_name}, role: backend, platform: ec2, instance: ${e.legacy_name}-backend }
%{ endfor ~}
    relabel_configs:
      - target_label: job
        replacement: spring-actuator

  # ---- MySQL ----
  - job_name: mysql
    static_configs:
%{ for e in environments ~}
      - targets: ["${e.database_ip}:9104"]
        labels: { env: ${e.name}, role: database, instance: ${e.name}-database }
%{ endfor ~}

  # ---- Redis ----
  - job_name: redis
    static_configs:
%{ for e in environments ~}
      - targets: ["${e.redis_ip}:9121"]
        labels: { env: ${e.name}, role: redis, instance: ${e.name}-redis }
%{ endfor ~}

  # ---- Synthetic checks: internal health (DB/Redis included) ----
  - job_name: blackbox-health
    metrics_path: /probe
    params: { module: [http_health] }
    static_configs:
%{ for e in environments ~}
      - targets: ["http://${e.backend_dns}:8081/actuator/health"]
        labels: { env: ${e.name}, role: backend, probe: internal-health }
      - targets: ["http://${e.legacy_backend_ip}:8081/actuator/health"]
        labels: { env: ${e.legacy_name}, role: backend, probe: internal-health }
%{ endfor ~}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: target
      - source_labels: [env]
        target_label: instance
        replacement: "$1-internal-health"
      - target_label: __address__
        replacement: blackbox:9115

  # ---- Synthetic checks: public HTTPS endpoint (TLS, ALB, cert expiry) ----
  - job_name: blackbox-public
    metrics_path: /probe
    params: { module: [https_public] }
    static_configs:
%{ for e in environments ~}
      - targets: ["https://${e.domain}/"]
        labels: { env: ${e.name}, role: backend, probe: public-https }
      - targets: ["https://${e.legacy_domain}/"]
        labels: { env: ${e.legacy_name}, role: backend, probe: public-https }
%{ endfor ~}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: target
      - source_labels: [env]
        target_label: instance
        replacement: "$1-public-https"
      - target_label: __address__
        replacement: blackbox:9115

  - job_name: blackbox-exporter
    static_configs:
      - targets: ["blackbox:9115"]
        labels: { env: shared, role: monitoring, instance: monitoring-blackbox }
