#!/bin/bash
set -euo pipefail
${common}

apt-get install -y apache2-utils sysbench wrk

# ---- k6 ----
download "https://github.com/grafana/k6/releases/download/${k6_version}/k6-${k6_version}-linux-amd64.tar.gz" /tmp/k6.tgz
tar -xzf /tmp/k6.tgz -C /tmp
install -m 755 /tmp/k6-${k6_version}-linux-amd64/k6 /usr/local/bin/k6

# 부하 대상 주소 (내부망 직접 / 공개 HTTPS) 와 결과 전송 주소
#   *_INTERNAL_URL: Cloud Map DNS. 태스크가 여러 개면 조회할 때마다 IP 순서가 바뀐다.
#   *_BACKEND_DNS : 태스크 IP 목록 조회용 (dig +short <dns>). 사용자를 특정 서버에 고정할 때 쓴다.
cat > /etc/loadtest.env <<'ENVEOF'
PROMETHEUS_RW_URL=http://${monitoring_ip}:9090/api/v1/write
%{ for e in environments ~}
${upper(e.name)}_INTERNAL_URL=http://${e.backend_dns}:8080
${upper(e.name)}_BACKEND_DNS=${e.backend_dns}
${upper(e.name)}_PUBLIC_URL=https://${e.domain}
ONE_${upper(e.name)}_INTERNAL_URL=http://${e.legacy_backend_ip}:8080
ONE_${upper(e.name)}_PUBLIC_URL=https://${e.legacy_domain}
%{ endfor ~}
ENVEOF

cat > /usr/local/bin/loadtest <<'LOADTEST_EOF'
${loadtest_script}
LOADTEST_EOF
chmod 755 /usr/local/bin/loadtest

mkdir -p /opt/loadtest
cat > /opt/loadtest/smoke.js <<'SMOKE_EOF'
${smoke_script}
SMOKE_EOF
chmod -R a+rwX /opt/loadtest

# 커널 튜닝: 많은 동시 연결
cat > /etc/sysctl.d/90-loadtest.conf <<'SYSEOF'
net.ipv4.ip_local_port_range = 1024 65535
net.ipv4.tcp_tw_reuse = 1
net.core.somaxconn = 65535
SYSEOF
sysctl --system >/dev/null
echo '* soft nofile 1048576' >> /etc/security/limits.conf
echo '* hard nofile 1048576' >> /etc/security/limits.conf

echo "[bootstrap] done $(date -Is)"
