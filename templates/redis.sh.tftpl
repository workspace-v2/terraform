#!/bin/bash
set -euo pipefail
${common}

apt-get install -y redis-server

# Recommended kernel settings for Redis persistence (fork for AOF rewrite).
echo 'vm.overcommit_memory = 1' > /etc/sysctl.d/90-redis.conf
sysctl -p /etc/sysctl.d/90-redis.conf

sed -i -E '/^(bind|protected-mode|requirepass|maxmemory|maxmemory-policy|appendonly|appendfsync|supervised) /d' /etc/redis/redis.conf
cat >> /etc/redis/redis.conf <<'EOF'
bind ${private_ip} 127.0.0.1
protected-mode yes
requirepass ${redis_password}
maxmemory ${maxmemory_mb}mb
maxmemory-policy volatile-lru
appendonly yes
appendfsync everysec
supervised systemd
EOF
systemctl enable redis-server
systemctl restart redis-server

# ---- redis_exporter ----
download "https://github.com/oliver006/redis_exporter/releases/download/${exporter_version}/redis_exporter-${exporter_version}.linux-amd64.tar.gz" /tmp/redis_exporter.tgz
tar -xzf /tmp/redis_exporter.tgz -C /tmp
install -m 755 /tmp/redis_exporter-${exporter_version}.linux-amd64/redis_exporter /usr/local/bin/redis_exporter
id redis_exporter >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin redis_exporter

cat > /etc/redis_exporter.env <<'EOF'
REDIS_ADDR=redis://127.0.0.1:6379
REDIS_PASSWORD=${redis_password}
REDIS_EXPORTER_WEB_LISTEN_ADDRESS=:9121
REDIS_EXPORTER_INCL_SYSTEM_METRICS=true
EOF
chown root:redis_exporter /etc/redis_exporter.env
chmod 640 /etc/redis_exporter.env

cat > /etc/systemd/system/redis_exporter.service <<'EOF'
[Unit]
Description=Prometheus Redis exporter
After=network-online.target redis-server.service

[Service]
User=redis_exporter
EnvironmentFile=/etc/redis_exporter.env
ExecStart=/usr/local/bin/redis_exporter
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now redis_exporter

echo "[bootstrap] done $(date -Is)"
